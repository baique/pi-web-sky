# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# Local tooling artifacts
/.codegraph/
/.pi/
/.playwright-mcp/
*.png
!docs/**/*.png
.worktrees/
.superpowers/

# 本地调试工具与运行日志（不入库）
/.agent/script/

# 临时测试资源（壁纸/动画调试产物，不入库）
/manual.gif
/test-anim.gif
/test-wallpaper-8000x4000.jpg

# 本地运行日志（dev server 等），不入库
/.agent/logs/
